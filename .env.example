# Microservicio de auditoría (AUDA) — configuración operativa.
# Copiar a `.env` y ajustar. `.env` está en `.gitignore`; nunca subir secretos reales.

# ---------------------------------------------------------------------------
# Obligatoria — el servicio se niega a arrancar sin ella
# ---------------------------------------------------------------------------
# Secreto compartido que el Orquestador envía como `Authorization: Bearer <token>`.
# Sin default a propósito: un servicio desprotegido no debe levantarse. Es lo que
# convierte un desalineamiento de configuración en un fallo de arranque y no en
# una auditoría que deja de crecer en silencio.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_TOKEN=

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=pdf_extractext_audit
MONGO_AUDIT_LOGS_COLLECTION=audit_logs
MONGO_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Máximo tamaño del body de la petición, en bytes. 1 MiB es holgado para el
# contrato real (el campo `details` tiene su propio límite, más abajo).
MAX_BODY_BYTES=1048576

# Tope del campo `details` ya serializado, en bytes. Evita que un único evento
# ocupe la colección entera; los cuerpos mayores se rechazan con 413.
MAX_DETAILS_BYTES=65536

# ---------------------------------------------------------------------------
# Paginación del listado global
# ---------------------------------------------------------------------------
# Coincide con el `defaultLimit` del Orquestador, para no alterar el
# comportamiento del cliente Go.
DEFAULT_LIMIT=10
MAX_LIMIT=100
MAX_SKIP=10000

# ---------------------------------------------------------------------------
# Retención
# ---------------------------------------------------------------------------
# Días de retención de los logs, aplicada como TTL de MongoDB sobre
# `performed_at`. 0 desactiva el TTL. La clave de idempotencia incluye
# `performed_at`, así que eliminar logs antiguos no altera la deduplicación
# dentro de la ventana de retención.
RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Metadata
# ---------------------------------------------------------------------------
APP_NAME=Audit Log Microservice